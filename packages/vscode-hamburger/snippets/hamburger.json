  "Reactive Counter": {
    "prefix": "@hamburger-counter",
    "body": [
      "import { listen, VStack, Text, HStack, Button } from '@hamburger/core';",
      "",
      "function Counter(data) {",
      "  return VStack(",
      "    Text(String(data.count)).fontSize(48).bold(),",
      "    HStack(",
      "      Button('-').onClick(() => data.count--),",
      "      Button('+').onClick(() => data.count++)",
      "    ).justifyContent('center')",
      "  ).padding(20);",
      "}",
      "",
      "function App() {",
      "  const withCount = listen({ count: ${1:0} });",
      "  return VStack(",
      "    withCount(Counter)()",
      "  );",
      "}",
      "$0"
    ],
    "description": "Create a reactive counter example"
  },
