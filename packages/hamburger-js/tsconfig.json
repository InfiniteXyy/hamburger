{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "es2022",
    "module": "esnext",
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
