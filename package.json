{
  "name": "hamburger",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "repository": "https://github.com/hamburger-js/hamburger",
  "workspaces": [
    "examples/*",
    "experiment",
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Yiyang Xu <xuyiyangwing@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build:cli": "cd packages/hamburger-cli && pnpm build",
    "build:lib": "cd packages/hamburger-js && pnpm build",
    "build:dsl": "cd packages/hamburger-loader && pnpm build",
    "build": "concurrently \"npm:build:*\"",
    "test:lib": "cd packages/hamburger-js && pnpm test",
    "dev:lib": "cd packages/hamburger-js && pnpm dev",
    "test": "concurrently \"npm:test:*\"",
    "dev": "pnpm dev:lib",
    "playground": "cd examples/basic && pnpm start",
    "deps": "taze major -w -r"
  },
  "devDependencies": {
    "@hamburger/core": "workspace:*",
    "@hamburger/loader": "workspace:*",
    "@hamburger/platform-react": "workspace:*",
    "@parcel/transformer-sass": "^2.13.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.0.0",
    "parcel": "^2.13.0",
    "prettier": "^3.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rimraf": "^6.0.0",
    "rollup": "^4.28.0",
    "taze": "^0.18.0",
    "tslib": "^2.8.0",
    "typescript": "~5.7.0"
  }
}
