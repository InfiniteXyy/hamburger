{
  "name": "hamburger-static-example",
  "version": "1.0.0",
  "main": "index.js",
  "devDependencies": {
    "@hamburger/core": "workspace:*",
    "@hamburger/loader": "workspace:*",
    "@hamburger/static": "workspace:*",
    "concurrently": "^6.3.0",
    "live-server": "^1.2.1",
    "nodemon": "^2.0.14",
    "sucrase": "^3.20.3"
  },
  "scripts": {
    "build": "sucrase-node index.js",
    "serve": "live-server ./dist --watch ./dist",
    "watch": "nodemon --exec sucrase-node index.js",
    "dev": "concurrently \"npm run serve\" \"npm run watch\""
  },
  "nodemonConfig": {
    "ignore": [
      "dist/*"
    ]
  }
}
